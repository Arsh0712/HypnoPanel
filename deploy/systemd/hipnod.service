# Installed by installer/install.sh (canonical copy for reference)
[Unit]
Description=HipnoType Panel daemon
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=hipno
Group=hipno
Environment=HIPNO_STATE_DIR=/var/lib/hipno
EnvironmentFile=-/etc/hipno/hipnod.env
ExecStart=/usr/local/bin/hipnod --state /var/lib/hipno --config /etc/hipno
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/hipno /var/log/hipno /var/backups/hipno
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
